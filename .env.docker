# =============================================================================
# SMART EMAIL ADVISOR - DOCKER ENVIRONMENT CONFIGURATION
# =============================================================================
# Скопіюйте цей файл в .env та заповніть реальними значеннями

# =============================================================================
# AI CONFIGURATION
# =============================================================================
# OpenAI API ключ (обов'язково!)
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4
AI_TEMPERATURE=0.3

# =============================================================================
# AWS CONFIGURATION  
# =============================================================================
# AWS основні налаштування
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Bedrock (для LLM)
AWS_BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AWS S3 (для файлового сховища)
AWS_S3_BUCKET=smart-email-advisor-storage
AWS_S3_REGION=us-east-1

# AWS SES (для email обробки)
AWS_SES_REGION=us-east-1
AWS_SES_CONFIG_SET=smart-email-advisor-config
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com

# AWS SNS (для повідомлень)
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:smart-email-advisor-notifications

# AWS Lambda
AWS_LAMBDA_FUNCTION=smart-email-processor

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=smart_email_advisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=

# =============================================================================
# APPLICATION SECURITY
# =============================================================================
SECRET_KEY=docker-secret-key-change-in-production-very-long-and-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
WEBHOOK_SECRET=webhook-secret-key-change-in-production

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
DEBUG=true
ENVIRONMENT=docker
LOG_LEVEL=INFO
NODE_ENV=development
GENERATE_SOURCEMAP=false

# =============================================================================
# NETWORKING PORTS
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090

# =============================================================================
# EMAIL PROCESSING
# =============================================================================
EMAIL_QUEUE_NAME=email_processing
MAX_EMAILS_PER_MINUTE=100

# SMTP Configuration (fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# =============================================================================
# LLM RULES CONFIGURATION
# =============================================================================
LLM_RULES_PATH=/app/config/llm_rules.json

# =============================================================================
# SERVICE URLs (для внутрішньої комунікації)
# =============================================================================
AI_AGENT_URL=http://ai-agent:8001
BACKEND_URL=http://backend:8000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9100