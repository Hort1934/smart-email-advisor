# =============================================================================
# SMART EMAIL ADVISOR - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production to version control!

# =============================================================================
# AI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4
AI_TEMPERATURE=0.3

# =============================================================================
# AWS CONFIGURATION  
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Bedrock (optional - for LLM)
AWS_BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com

# AWS S3 (for file storage)
AWS_S3_BUCKET=smart-email-advisor-storage

# AWS SES (for email processing)
AWS_SES_REGION=us-east-1
AWS_SES_CONFIG_SET=smart-email-advisor-config

# AWS SNS (for notifications)
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:smart-email-advisor-notifications

# AWS Lambda
AWS_LAMBDA_FUNCTION=smart-email-processor

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=smart_email_advisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=

# =============================================================================
# APPLICATION SECURITY
# =============================================================================
# IMPORTANT: Generate a strong secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_SECURE_SECRET_KEY_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
WEBHOOK_SECRET=CHANGE_THIS_TO_SECURE_WEBHOOK_SECRET

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
NODE_ENV=production
GENERATE_SOURCEMAP=false

# =============================================================================
# EMAIL PROCESSING
# =============================================================================
EMAIL_QUEUE_NAME=email_processing
MAX_EMAILS_PER_MINUTE=100

# SMTP Configuration (fallback)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# =============================================================================
# SERVICE URLs
# =============================================================================
# Replace YOUR_ELASTIC_IP with your actual EC2 Elastic IP address
NEXT_PUBLIC_API_URL=http://35.175.135.43/api
REACT_APP_API_URL=http://35.175.135.43/api
REACT_APP_WS_URL=ws://YOUR_ELASTIC_IP

# =============================================================================
# LLM RULES CONFIGURATION
# =============================================================================
LLM_RULES_PATH=/app/config/llm_rules.json
