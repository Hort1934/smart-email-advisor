# Docker environment variables
# Скопіюйте цей файл в .env та заповніть реальними значеннями

# OpenAI API ключ (обов'язково!)
OPENAI_API_KEY=your-openai-api-key-here

# База даних
POSTGRES_DB=smart_email_advisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Redis
REDIS_PASSWORD=

# Backend
SECRET_KEY=docker-secret-key-change-in-production
DEBUG=true
ENVIRONMENT=docker

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080