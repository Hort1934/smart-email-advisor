# AWS Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "smart-email-advisor"
environment  = "prod"

# Networking (Dedicated VPC)
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidr  = "10.20.1.0/24"
# availability_zone = "us-east-1a"  # optional; leave commented to auto-pick

# EC2 Configuration
instance_type = "t3.medium"  # Options: t3.small, t3.medium, t3.large, t3.xlarge
volume_size   = 40           # GB

# SSH Configuration
# Option 1: Create a new key pair automatically (recommended)
create_key_pair = true                   # Set to true to auto-create key pair
# key_pair_name = ""                    # Leave empty when create_key_pair = true

# Option 2: Use an existing key pair
# create_key_pair = false
# key_pair_name = "my-existing-key-pair"  # Name of your existing AWS Key Pair

instance_user = "ubuntu"

# Security: Restrict SSH access to your IP
# Get your IP: curl -s https://checkip.amazonaws.com
# Format: ["YOUR_IP/32"]
ssh_allowed_cidrs = ["0.0.0.0/0"]  # WARNING: Change this to your IP for security!
